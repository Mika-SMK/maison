# Copier ce fichier en .env sur le NAS, à côté du conteneur.
# Remplir les valeurs là-bas. Ne pas commiter .env.

# Clé API personnelle Cursor (Dashboard → API Keys).
# Une clé de service ne démarre pas un worker My Machines.
CURSOR_API_KEY=

# ntopng. Laisser NTOPNG_USER et NTOPNG_PASSWORD vides si l'interface
# du LAN n'exige pas d'authentification.
NTOPNG_URL=
NTOPNG_USER=
NTOPNG_PASSWORD=

# Contrôleur Omada. Renseigner le couple utilisateur/mot de passe,
# ou le couple client API, selon ce que le contrôleur expose.
OMADA_URL=
OMADA_USERNAME=
OMADA_PASSWORD=
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=

# Freebox. FREEBOX_APP_TOKEN est le jeton déjà autorisé sur la box,
# après la validation physique faite à la maison.
FREEBOX_URL=
FREEBOX_APP_ID=
FREEBOX_APP_TOKEN=
